# Terraform working directory and provider plugins
.terraform/
.terraform.tfstate.lock.info

# State files — this project uses a remote Azure backend, so no state should
# ever be committed. These patterns are a safety net.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Saved plans can contain variable values, including secrets
*.tfplan
*.tfplan.bin
tfplan*

# Variable files — passwords are supplied via TF_VAR_* environment variables
# and must never be committed
*.tfvars
*.tfvars.json
!example.tfvars

# Crash logs
crash.log
crash.*.log

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Generated by the Terraform provisioner at apply time
ansible/inventory.ini
ansible/fetched_keys/
ansible/generated_pages/
*.retry
